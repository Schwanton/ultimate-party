{
  "id": "guess-the-clicks",
  "name": {
    "de": "Guess the Clicks!",
    "en": "Guess the Clicks!"
  },
  "description": {
    "de": "Ein zufälliges YouTube-Video – wie oft wurde es angeschaut? Wer am nächsten dran ist, holt den Punkt.",
    "en": "A random YouTube video – how many views does it have? Closest guess takes the point."
  },
  "minPlayers": 2,
  "maxPlayers": 100,
  "audience": true,
  "minutes": 10,
  "color": "#FF5A4E",
  "sdkVersion": 1,
  "autoSounds": false,
  "contentFields": [
    "query"
  ],
  "version": "1.0.0",
  "author": "UP!",
  "secrets": [
    {
      "id": "youtubeApiKey",
      "label": {
        "de": "YouTube-API-Schlüssel",
        "en": "YouTube API key"
      },
      "help": {
        "de": "Kostenlos bei Google: Projekt anlegen, „YouTube Data API v3“ aktivieren, unter „Anmeldedaten“ einen API-Schlüssel erstellen und hier einfügen.",
        "en": "Free from Google: create a project, enable “YouTube Data API v3”, create an API key under “Credentials” and paste it here."
      },
      "url": "https://developers.google.com/youtube/v3/getting-started"
    }
  ],
  "options": [
    {
      "id": "videos",
      "label": {
        "de": "Videos",
        "en": "Videos"
      },
      "default": 8,
      "min": 3,
      "max": 20
    },
    {
      "id": "guessTime",
      "label": {
        "de": "Zeit zum Tippen",
        "en": "Time to guess"
      },
      "default": 40,
      "choices": [
        {
          "value": 20,
          "label": {
            "de": "20 s",
            "en": "20 s"
          }
        },
        {
          "value": 40,
          "label": {
            "de": "40 s",
            "en": "40 s"
          }
        },
        {
          "value": 60,
          "label": {
            "de": "60 s",
            "en": "60 s"
          }
        },
        {
          "value": 90,
          "label": {
            "de": "90 s",
            "en": "90 s"
          }
        }
      ]
    }
  ]
}
