{
  "id": "guess-the-clicks",
  "name": {
    "de": "Guess the Clicks!",
    "en": "Guess the Clicks!"
  },
  "description": {
    "de": "Ein zufälliges YouTube-Video – wie oft wurde es angeschaut? Je näher dein Tipp, desto mehr Punkte.",
    "en": "A random YouTube video – how many views does it have? The closer your guess, the more points."
  },
  "minPlayers": 2,
  "maxPlayers": 100,
  "audience": true,
  "minutes": 10,
  "color": "#FF5A4E",
  "tags": [
    "guess",
    "quick"
  ],
  "noDeck": true,
  "sdkVersion": 1,
  "autoSounds": false,
  "contentFields": [
    "query"
  ],
  "version": "1.3.0",
  "author": "UP!",
  "secrets": [
    {
      "id": "youtubeApiKey",
      "label": {
        "de": "YouTube-API-Schlüssel",
        "en": "YouTube API key"
      },
      "help": {
        "de": "Kostenlos bei Google: Projekt anlegen, „YouTube Data API v3“ aktivieren, unter „Anmeldedaten“ einen API-Schlüssel erstellen und hier einfügen.",
        "en": "Free from Google: create a project, enable “YouTube Data API v3”, create an API key under “Credentials” and paste it here."
      },
      "url": "https://developers.google.com/youtube/v3/getting-started"
    }
  ],
  "options": [
    {
      "id": "videos",
      "label": {
        "de": "Videos",
        "en": "Videos"
      },
      "default": 8,
      "min": 3,
      "max": 20
    },
    {
      "id": "guessTime",
      "label": {
        "de": "Zeit zum Tippen",
        "en": "Time to guess"
      },
      "default": 40,
      "choices": [
        {
          "value": 20,
          "label": {
            "de": "20 s",
            "en": "20 s"
          }
        },
        {
          "value": 40,
          "label": {
            "de": "40 s",
            "en": "40 s"
          }
        },
        {
          "value": 60,
          "label": {
            "de": "60 s",
            "en": "60 s"
          }
        },
        {
          "value": 90,
          "label": {
            "de": "90 s",
            "en": "90 s"
          }
        }
      ]
    },
    {
      "id": "scoring",
      "label": {
        "de": "Wertung",
        "en": "Scoring"
      },
      "default": "rank",
      "help": {
        "de": "Nach Platz: Nächster 1000, Letzter 0, dazwischen gleichmäßig. Nur der Nächste: 1 Punkt für den besten Tipp. Nach Entfernung: genau 1000, doppelt/halb so viel 700, 10-mal daneben 0. Entfernung + Bonus: dazu +250 für den Nächsten, +500 für höchstens 5 % daneben.",
        "en": "By rank: closest 1000, last 0, evenly in between. Closest only: 1 point for the best guess. By distance: spot on 1000, double/half 700, 10× off 0. Distance + bonus: plus +250 for the closest, +500 for within 5 %."
      },
      "choices": [
        {
          "value": "rank",
          "label": {
            "de": "Nach Platz",
            "en": "By rank"
          }
        },
        {
          "value": "best",
          "label": {
            "de": "Nur der Nächste",
            "en": "Closest only"
          }
        },
        {
          "value": "distance",
          "label": {
            "de": "Nach Entfernung",
            "en": "By distance"
          }
        },
        {
          "value": "bonus",
          "label": {
            "de": "Entfernung + Bonus",
            "en": "Distance + bonus"
          }
        }
      ]
    },
    {
      "id": "strictness",
      "label": {
        "de": "Strenge",
        "en": "Strictness"
      },
      "default": "normal",
      "help": {
        "de": "Nur für „Nach Entfernung“ und „Entfernung + Bonus“: Ab wann gibt es 0 Punkte?",
        "en": "Only for “By distance” and “Distance + bonus”: when do you get 0 points?"
      },
      "choices": [
        {
          "value": "normal",
          "label": {
            "de": "Normal (10-mal daneben = 0)",
            "en": "Normal (10× off = 0)"
          }
        },
        {
          "value": "loose",
          "label": {
            "de": "Locker (100-mal daneben = 0)",
            "en": "Relaxed (100× off = 0)"
          }
        }
      ]
    },
    {
      "id": "theme",
      "label": { "de": "Videos", "en": "Videos" },
      "default": "all",
      "choices": [
        { "value": "all", "label": { "de": "Alles zufällig", "en": "Anything" } },
        { "value": "music", "label": { "de": "Musik", "en": "Music" } },
        { "value": "animals", "label": { "de": "Tiere", "en": "Animals" } },
        { "value": "gaming", "label": { "de": "Gaming", "en": "Gaming" } },
        { "value": "sport", "label": { "de": "Sport", "en": "Sports" } },
        { "value": "food", "label": { "de": "Essen & Kochen", "en": "Food & cooking" } }
      ]
    },
    {
      "id": "views",
      "label": { "de": "Bekanntheit", "en": "Popularity" },
      "help": { "de": "Eher bekannte Videos haben mindestens 10.000 Aufrufe – winzige Videos mit 12 Aufrufen fallen weg.", "en": "Better-known videos have at least 10,000 views – tiny videos with 12 views are skipped." },
      "default": "all",
      "choices": [
        { "value": "all", "label": { "de": "Alles", "en": "Everything" } },
        { "value": "known", "label": { "de": "Eher bekannte Videos", "en": "Better-known videos" } }
      ]
    }
  ]
}
