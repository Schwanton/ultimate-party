{
  "id": "montagsmaler",
  "name": { "de": "Montagsmaler", "en": "Sketch & Guess" },
  "description": {
    "de": "Einer malt live aufs Handy, alle anderen raten um die Wette – auch in zwei Teams.",
    "en": "One player draws live on their phone, everyone else races to guess – in two teams, too."
  },
  "minPlayers": 2,
  "maxPlayers": 100,
  "audience": true,
  "minutes": 15,
  "color": "#E8336F",
  "tags": ["draw", "guess"],
  "sdkVersion": 1,
  "contentFields": ["word"],
  "version": "1.1.0",
  "author": "UP!",
  "options": [
    {
      "id": "mode",
      "label": { "de": "Spielart", "en": "Mode" },
      "default": "ffa",
      "choices": [
        { "value": "ffa", "label": { "de": "Jeder gegen jeden", "en": "Free for all" } },
        { "value": "team", "label": { "de": "Zwei Teams", "en": "Two teams" } }
      ],
      "help": {
        "de": "Teams ab 4 Spielern: Das malende Team rät, schafft es das nicht, darf das andere Team 15 Sekunden lang klauen.",
        "en": "Teams need 4+ players: the drawing team guesses; if they fail, the other team gets 15 seconds to steal."
      }
    },
    {
      "id": "turns",
      "label": { "de": "Runden", "en": "Rounds" },
      "default": 1,
      "choices": [
        { "value": 1, "label": { "de": "Jeder malt einmal", "en": "Everyone draws once" } },
        { "value": 2, "label": { "de": "Jeder malt zweimal", "en": "Everyone draws twice" } },
        { "value": 3, "label": { "de": "Jeder malt dreimal", "en": "Everyone draws three times" } },
        { "value": 0, "label": { "de": "Feste Anzahl", "en": "Fixed number" } }
      ],
      "help": {
        "de": "Bei mehr als 10 Spielern geht ein Durchgang höchstens 10 Runden. „Feste Anzahl“: Rundenzahl mit Plus und Minus wählen.",
        "en": "With more than 10 players a pass stops at 10 rounds. “Fixed number”: pick the rounds with plus and minus."
      }
    },
    {
      "id": "rounds",
      "label": { "de": "Anzahl Runden", "en": "Number of rounds" },
      "default": 8,
      "min": 2,
      "max": 30,
      "showIf": { "id": "turns", "value": 0 }
    },
    {
      "id": "drawTime",
      "label": { "de": "Zeit zum Malen", "en": "Drawing time" },
      "default": 80,
      "choices": [
        { "value": 60, "label": { "de": "60 s", "en": "60 s" } },
        { "value": 80, "label": { "de": "80 s", "en": "80 s" } },
        { "value": 100, "label": { "de": "100 s", "en": "100 s" } }
      ]
    }
  ]
}
